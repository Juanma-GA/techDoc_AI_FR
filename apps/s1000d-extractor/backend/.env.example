# Copy to .env and fill in. .env is gitignored.

APP_NAME=S1000d Extractor
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite par défaut. Pour Postgres : postgresql://user:pwd@host:5432/db
DATABASE_URL=sqlite:///./data/s1000d-extractor.db
STORAGE_DIR=./data/storage
# Optional overrides. By default, demo uses a sibling SQLite DB and storage folder.
# Required when DATABASE_URL uses a non-SQLite database.
DEMO_DATABASE_URL=
DEMO_STORAGE_DIR=

# Bind uvicorn. Local (palier 1) : 127.0.0.1.
BIND_HOST=127.0.0.1

# Liste blanche CSV
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8006

MAX_UPLOAD_SIZE_MB=50
PDF_CUT_REQUIRES_VALIDATION=True
