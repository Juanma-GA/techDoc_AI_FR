# Frontend env — exposed to the browser at build time. Never put secrets here.
# All Vite-public vars MUST start with VITE_.

# API base URL. Defaults to /api/v1 (proxied via vite dev server).
VITE_API_BASE_URL=/api/v1

# Optional backend port for Vite development. When omitted, Vite probes
# 8003..8023 and uses the first Doc Reviewer backend that answers /health.
# VITE_BACKEND_PORT=8003
