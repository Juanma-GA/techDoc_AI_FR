APP_NAME=doc-reviewer
APP_VERSION=0.1.0
# DEBUG active aussi le mode debug FastAPI, INFO est le fonctionnement courant,
# WARNING/ERROR reduisent le bruit, NONE ou OFF coupent les logs.
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./data/doc-reviewer.db
STORAGE_DIR=./data/storage

# Bind uvicorn. Local (palier 1) : 127.0.0.1. Au deploiement expose, le passer
# a l'hote cible rend ENCRYPTION_KEY + CORS prod OBLIGATOIRES (fail-fast au boot).
BIND_HOST=127.0.0.1

# L'application n'a AUCUNE authentification. Toute exposition (bind non local,
# OU acces via un reverse proxy : nginx, IIS/ARR...) exige un reverse proxy
# AUTHENTIFIANT (SSO) devant elle, atteste ici par l'IT. Sans cette attestation,
# le demarrage expose est refuse et toute requete relayee (X-Forwarded-For,
# Forwarded...) est rejetee (403 EXPOSURE_NOT_ALLOWED).
BEHIND_AUTH_PROXY=false

# Noms d'hote (en-tete Host) acceptes en plus de localhost / 127.0.0.1 / [::1]
# (anti DNS-rebinding). Vide pour le poste local. Ex. : docrev.example.com
ALLOWED_HOSTS=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8003
MAX_UPLOAD_SIZE_MB=100

# Chiffrement de la cle Mistral stockee en DB. Vide en local (clair). En prod,
# generer : python -c "from app.core.encryption import generate_key; print(generate_key())"
ENCRYPTION_KEY=

DEFAULT_TARGET_UNIT_SYSTEM=auto

# Conversions .doc/.docx/PDF. auto = Microsoft Word, puis LibreOffice s'il est
# installe ; word ou libreoffice = ce moteur seul.
OFFICE_CONVERTER=auto
# Chemin de soffice.exe (ou de son dossier) si LibreOffice n'est ni sur le
# PATH, ni dans Program Files, ni en version portable a un emplacement connu.
# DR_SOFFICE_PATH=
# Etiquette de confidentialite Microsoft Purview (GUID) posee sur un .docx
# produit par conversion quand le document n'en porte pas. OBLIGATOIRE sur un
# poste ou l'etiquetage est impose (Word refuse sinon d'enregistrer le .docx).
# Choisie par l'IT. Tenant ATEXIS :
#   C0-Public       d5b0e46e-af26-40f8-bc06-c0e471e18c78
#   C1-Internal     4f9646e7-a2b7-4055-b37c-fae88eceb046
#   C2-Restricted   f44e79de-7414-4831-b055-2e5a46a0d301
#   C3-Confidential 3f595d1a-a546-4e1d-a62e-643892992159
WORD_SENSITIVITY_LABEL_ID=
# Au-dela de ce delai, une conversion Word est consideree bloquee et son
# instance WINWORD (elle seule) est arretee.
WORD_CONVERT_TIMEOUT_SECONDS=180

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
# Points d'acces LLM autorises (https). La cle API n'est jamais envoyee ailleurs.
MISTRAL_ALLOWED_BASE_URLS=https://api.mistral.ai
MISTRAL_CHAT_MODEL=mistral-small-latest
