{
  "fields": {
    "meta_revision_date": {
      "type": "string",
      "required": true,
      "labels": {"fr": "Date de revision", "en": "Revision date"},
      "max_length": 60
    },
    "meta_cmm_number": {
      "type": "string",
      "required": true,
      "labels": {"fr": "Numéro CMM", "en": "CMM number"},
      "max_length": 120
    },
    "meta_first_issue_date": {
      "type": "string",
      "required": true,
      "labels": {"fr": "Date de premiere issue", "en": "First issue date"},
      "max_length": 60
    },
    "meta_last_issue_date": {
      "type": "string",
      "required": false,
      "labels": {"fr": "Date de la revision precedente", "en": "Previous revision date"},
      "max_length": 60
    },
    "meta_revision_number": {
      "type": "string",
      "required": true,
      "labels": {"fr": "Numéro de révision", "en": "Revision number"},
      "max_length": 60
    },
    "meta_pnr_number": {
      "type": "string_list",
      "required": false,
      "labels": {"fr": "Numéros PNR", "en": "PNR numbers"},
      "max_items": 50
    },
    "meta_manufacturer": {
      "type": "enum",
      "required": true,
      "default": "Airbus",
      "labels": {"fr": "Constructeur", "en": "Manufacturer"},
      "allowed_values": [
        "Airbus",
        "Boeing"
      ]
    },
    "document_language": {
      "type": "enum",
      "required": true,
      "labels": {"fr": "Langue du document", "en": "Document language"},
      "allowed_values": [
        "fr",
        "en"
      ]
    }
  },
  "entities": {
    "cmm_number": "(?<!\\w)(\\d{2}-\\d{2}-\\d{2})(?!\\w)",
    "thales_logo_t": "^\\s*(T)\\s*$",
    "revision_number": "(?i)\\b(?:rev(?:ision)?\\s*(?:no\\.?|number)?\\s*[:#-]?\\s*)([^\\n|]+)",
    "revision_date": "(?i)\\brevision\\s+date\\s*[:#-]?\\s*([^\\n|]+)",
    "first_issue_date": "(?i)\\bfirst\\s+issue\\s+date\\s*[:#-]?\\s*([^\\n|]+)",
    "copyright_start_year": "(?i)(?:\\u00a9|copyright)\\s*(\\d{4})",
    "copyright_end_year": "(?i)(?:\\u00a9|copyright)\\s*\\d{4}\\s*[-\\u2013]\\s*(\\d{4})"
  },
  "tokens": {}
}