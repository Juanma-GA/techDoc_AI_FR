<!DOCTYPE concept PUBLIC "-//OASIS//DTD DITA 1.3 Concept//EN" "concept.dtd" [
  <!ENTITY product "Stadler FLIRT">
]>
<concept id="brake-overview" xml:lang="en" outputclass="reviewed">
  <title>Brake System Overview for &product;</title>
  <conbody>
    <p>The &product; uses a blended braking system. See <xref href="brakes.dita#x" format="dita"/> for details.</p>
    <ul>
      <li>Electrodynamic brake</li>
      <li>Pneumatic friction brake</li>
      <li>Magnetic track brake <ph outputclass="optional">(option)</ph></li>
    </ul>
    <table frame="all">
      <tgroup cols="2">
        <thead><row><entry>Mode</entry><entry>Use</entry></row></thead>
        <tbody>
          <row><entry>Service</entry><entry>Normal stops</entry></row>
          <row><entry>Emergency</entry><entry>Maximum deceleration</entry></row>
        </tbody>
      </tgroup>
    </table>
    <image href="brake-schematic.svg" placement="break" scale="80"/>
  </conbody>
</concept>
