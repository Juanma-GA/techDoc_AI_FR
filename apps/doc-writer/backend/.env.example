# Copy to .env and fill in. .env is gitignored.

APP_NAME=doc-writer
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite par défaut. Pour Postgres : postgresql://user:pwd@host:5432/db
DATABASE_URL=sqlite:///./data/doc-writer.db
STORAGE_DIR=./data/storage

# Tier mode: tier1=local 127.0.0.1 only, tier2=cloud 0.0.0.0 with auth.
# Default: tier1 (palier 1, development). Set to tier2 for Azure deployment.
TIER_MODE=tier1

# Bind uvicorn. Local (palier 1) : 127.0.0.1. Au deploiement expose, le passer
# a l'hote cible rend ENCRYPTION_KEY + CORS prod OBLIGATOIRES (fail-fast au boot).
BIND_HOST=127.0.0.1

# Deploiement derriere un reverse-proxy (ex. nginx du workspace) : uvicorn
# reste sur 127.0.0.1 mais l'app est joignable de l'exterieur. A true, la
# posture de securite stricte s'applique (auth pleinement configuree
# obligatoire) meme si BIND_HOST reste local. NE PAS mettre a true sans avoir
# AUTH_ENABLED + AUTHDB + MS365 configures, sinon fail-fast au boot.
EXPOSED_BEHIND_PROXY=false

# Liste blanche CSV
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8002,http://127.0.0.1:8002

# Chiffrement de la cle Mistral stockee en DB. Vide en local (tier1) : une cle
# est auto-provisionnee sur disque (ENCRYPTION_KEY_PATH ci-dessous) plutot que
# de stocker en clair. En prod, fournir explicitement une cle :
# generer : python -c "from app.core.encryption import generate_key; print(generate_key())"
ENCRYPTION_KEY=
# Emplacement de la cle auto-provisionnee quand ENCRYPTION_KEY est vide.
# ENCRYPTION_KEY_PATH=./data/.encryption_key

MAX_UPLOAD_SIZE_MB=50

# Mistral — la clé peut aussi être configurée via l'UI Paramètres (table AppConfig)
MISTRAL_API_KEY=
# Endpoint IA APPROUVE (doc politique 159). api.mistral.ai (public) n'est PAS
# approuve pour du contenu C1/C2 : ne l'utiliser que hors de tout document reel.
MISTRAL_BASE_URL=https://api.2a91ec1812a1.dc.mistral.ai
# Allow-list CSV des endpoints IA approuves pour le routage de documents (F-01).
# save_settings() refuse (400 BASE_URL_NOT_ALLOWED) tout base_url hors de cette
# liste, saisi via /api/v1/settings (UI Parametres).
MISTRAL_ALLOWED_BASE_URLS=https://api.2a91ec1812a1.dc.mistral.ai
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed

# ---- MFA pilot (R1) — voir MFA_PILOT_CHECKLIST_DOC-WRITER_2026-09-14.md ----
# Desactive par defaut (false) : tier1 local completement inchange tant que
# ce bloc n'est pas explicitement configure.
AUTH_ENABLED=false

# AUTHDB : Postgres DEDIE (separe de DATABASE_URL), table email->role propre
# a doc-writer. Aucun mot de passe utilisateur n'y est stocke.
AUTHDB_HOST=
AUTHDB_PORT=5432
AUTHDB_DATABASE=
AUTHDB_USER=
AUTHDB_PASSWORD=
AUTHDB_SSLMODE=prefer
# §0 : email du premier admin, cree automatiquement au premier demarrage si
# la table AUTHDB est vide (sinon personne ne peut jamais appeler l'endpoint
# admin-only "creer un utilisateur"). Confirme par le proprietaire de l'app.
AUTH_SEED_ADMIN_EMAIL=ana.catalan@atexis.com

# Service MCP d'identite MS365 corporatif (deja deploye, meme cluster que le
# scan-service / RAG politique). HTTP PLAIN, pas https:// -- confirme par
# recon reelle (2026-09-14) que KleamPy et elecgraph pointent tous deux sur ce
# backend interne en clair (jamais le gateway https://.../443 + CA AISM), sur
# le reseau interne de confiance (jamais traverse par le proxy Zscaler).
MS365_MCP_ENDPOINT=http://172.21.28.81:8108/mcp
# Requis seulement si MS365_MCP_ENDPOINT ci-dessus est en https:// (pas le cas
# par defaut). Vide + https:// -> refuse au boot (fail-closed) tant qu'il manque.
MS365_CA_BUNDLE=

# Cle de signature/chiffrement de la cookie de session, auto-provisionnee sur
# disque si non fournie (meme pattern que ENCRYPTION_KEY_PATH).
# AUTH_SESSION_SECRET_PATH=./data/.auth_session_key
AUTH_SESSION_TTL_MINUTES=720

# Attribut `path` de la cookie de session. "/" en local. Derriere un
# reverse-proxy en sous-chemin, mettre le chemin QUE VOIT LE NAVIGATEUR
# (ex. /app/is-team-dev-1-jjm/docwriter/), sinon boucle de login infinie.
AUTH_COOKIE_PATH=/
