# Copy to .env and fill in. .env is gitignored.

APP_NAME=ECM-rename
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite par défaut. Pour Postgres : postgresql://user:pwd@host:5432/db
DATABASE_URL=sqlite:///./data/ecm-rename.db
STORAGE_DIR=./data/storage

# Bind uvicorn. En local : 127.0.0.1. Un bind expose exige une liste CORS
# configuree pour les origines autorisees.
BIND_HOST=127.0.0.1

# Liste blanche CSV
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8009

MAX_UPLOAD_SIZE_MB=50
