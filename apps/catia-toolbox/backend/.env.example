# Copy to .env and fill in. .env is gitignored.

APP_NAME=Catia Toolbox
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite par défaut. Pour Postgres : postgresql://user:pwd@host:5432/db
DATABASE_URL=sqlite:///./data/catia-toolbox.db
STORAGE_DIR=./data/storage

# Application locale uniquement.
BIND_HOST=127.0.0.1

# Liste blanche CSV
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:5188","http://localhost:8004"]

MAX_UPLOAD_SIZE_MB=50
