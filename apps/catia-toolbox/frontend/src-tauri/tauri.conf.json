{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catia Toolbox",
  "version": "0.1.0",
  "identifier": "com.atexis.catia-toolbox",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": { "runtime/": "runtime/" }
  }
}