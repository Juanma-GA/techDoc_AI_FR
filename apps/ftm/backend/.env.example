# Backend-local env file. Copy to `.env` and fill in real values.
# `.env` is gitignored.

# === App ===
APP_NAME=ftm
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# === Mistral ===
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_VISION_MODEL=pixtral-large-latest

# === DB / storage ===
DATABASE_URL=sqlite:///./data/ftm.db
STORAGE_DIR=./data/storage

# === HTTP ===
# CSV list — never "*".
# For production, add your domain: http://localhost:5173,https://172.21.28.92
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
MAX_UPLOAD_SIZE_MB=50

# === Security ===
# Host binding - use 0.0.0.0 for production server, 127.0.0.1 for local dev
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Rate limiting (requests per minute per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute

# Encryption key for secrets (API keys) stored in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production - leave empty for dev (INSECURE)
ENCRYPTION_KEY=
