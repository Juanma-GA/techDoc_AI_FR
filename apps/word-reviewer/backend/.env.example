# Copy to .env and fill in. .env is gitignored.

APP_NAME=Word-Reviewer
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite par défaut. Pour Postgres : postgresql://user:pwd@host:5432/db
DATABASE_URL=sqlite:///./data/word-reviewer.db
STORAGE_DIR=./data/storage

# Liste blanche CSV
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8006

MAX_UPLOAD_SIZE_MB=50

# Mistral — laisser vide si pas d'appel LLM
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
