# Copy to .env and fill in. .env is gitignored.

APP_NAME=ocr-vision
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# SQLite par défaut. Pour Postgres : postgresql://user:pwd@host:5432/db
DATABASE_URL=sqlite:///./data/ocr-vision.db
STORAGE_DIR=./data/storage

# Bind uvicorn. Local (palier 1) : 127.0.0.1. Au deploiement expose, le passer
# a l'hote cible rend ENCRYPTION_KEY + CORS prod OBLIGATOIRES (fail-fast au boot).
BIND_HOST=127.0.0.1

# Liste blanche CSV
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Chiffrement de la cle Mistral stockee en DB. Vide en local (clair). En prod,
# generer : python -c "from app.core.encryption import generate_key; print(generate_key())"
ENCRYPTION_KEY=

MAX_UPLOAD_SIZE_MB=50

# Mistral — laisser vide si pas d'appel LLM
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
