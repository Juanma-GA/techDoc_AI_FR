# Backend-local env file. Copy to `.env` and fill in real values.
# `.env` is gitignored.

# === App ===
APP_NAME=corpus-agent
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# === Mistral ===
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_VISION_MODEL=pixtral-large-latest

# === DB / storage ===
DATABASE_URL=sqlite:///./data/corpus-agent.db
STORAGE_DIR=./data/storage

# === HTTP ===
# CSV list — never "*".
# Pour la prod, ajouter le domaine servi par l'IT, ex :
#   CORS_ORIGINS=https://172.21.28.92,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
MAX_UPLOAD_SIZE_MB=50

# === Security (palier 2/3 — deploiement IT) ===
# ECART AU STANDARD local-first (cf. README). Defauts surs en local ; l'IT
# surcharge ces valeurs via le .env du serveur. Voir DEPLOYMENT_GUIDE.md.

# Bind host/port. 127.0.0.1 en local ; 0.0.0.0 en prod (connexions externes).
BIND_HOST=127.0.0.1
BIND_PORT=8000

# Rate limiting (slowapi) — requetes par minute, par IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute

# Cle de chiffrement des secrets (cle Mistral) stockes en base.
# Generer avec :
#   python -c "from app.core.encryption import generate_key; print(generate_key())"
# REQUISE en prod ; vide = stockage en clair (dev/local, INSECURE).
ENCRYPTION_KEY=
