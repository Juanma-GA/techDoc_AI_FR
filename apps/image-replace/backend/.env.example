# Copy to .env and fill in. .env is gitignored.

APP_NAME=Image Replace
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
OCR_MODEL_VARIANT=small
OCR_CPU_THREADS=10

# SQLite par défaut. Pour Postgres : postgresql://user:pwd@host:5432/db
DATABASE_URL=sqlite:///./data/image-replace.db
STORAGE_DIR=./data/storage

# Bind uvicorn. Local only: 127.0.0.1.
BIND_HOST=127.0.0.1

# Liste blanche CSV
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

MAX_UPLOAD_SIZE_MB=50
LAMA_SERVICE_PORT=8011
