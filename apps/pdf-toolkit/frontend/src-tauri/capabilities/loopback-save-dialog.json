{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-save-dialog",
  "description": "Allows the local backend UI to open the ZIP save dialog.",
  "windows": [
    "main"
  ],
  "local": false,
  "remote": {
    "urls": [
      "http://127.0.0.1:*/"
    ]
  },
  "permissions": [
    "dialog:allow-save"
  ]
}
