{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-window-theme",
  "description": "Allows the local PDF Toolkit UI to synchronize the native window theme.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:window:allow-set-theme"
  ]
}
