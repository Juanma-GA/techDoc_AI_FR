{
  "name": "@internal/design-tokens",
  "version": "0.2.0",
  "private": true,
  "description": "Single source of truth for the Midnight Executive design system. Consumed by Tailwind, CSS (generated theme.css) and JS/TS directly.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tokens.json": "./tokens.json",
    "./tailwind-preset": "./tailwind-preset.ts",
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css",
    "./base.css": "./base.css"
  },
  "files": [
    "index.ts",
    "tailwind-preset.ts",
    "tokens.json",
    "tokens.schema.json",
    "theme.css",
    "fonts.css",
    "base.css",
    "scripts"
  ],
  "scripts": {
    "build:theme": "node scripts/build-theme.mjs",
    "check:theme": "node scripts/build-theme.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/orbitron": "^5.1.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true }
  }
}
